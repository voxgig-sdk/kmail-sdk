# Entity: get_email

main: kit: entity: get_email: {

  alias: field: {}

  fields: [
    {
      name: "attachments"
      req: false
      short: "List of attachments"
      type: "`$ARRAY`"
    }
    {
      name: "body"
      req: false
      short: "Email body content"
      type: "`$STRING`"
    }
    {
      format: "email"
      name: "from"
      req: false
      short: "Sender email address"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the message"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "received_at"
      req: false
      short: "Timestamp when the message was received"
      type: "`$STRING`"
    }
    {
      name: "subject"
      req: false
      short: "Email subject"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "get_email"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/get_email"
          segments: [
            {
              lit: "get_email"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.messages`"
          }
        }
      ]
    }
  }



}
